# Copy this file to .env before starting the app:
#   cp .env.example .env
# Then replace AUTH_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Production must use its own long random value. The placeholder below is
# rejected at startup, and so is any secret shorter than 32 characters.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
