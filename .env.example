# Copy this file to .env before starting the app:
#   cp .env.example .env
# Then replace AUTH_SECRET with a brand-new random value of at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The old AUTH_SECRET was committed in git history (see HISTORY_CLEANUP.md).
# Do not reuse that value, this placeholder, or any secret shorter than 32
# characters. Production must generate its own secret. Startup rejects the
# placeholder and anything under 32 characters.
# SQLite is the database this repository runs and tests against.
DATABASE_URL="file:./dev.db"
# PostgreSQL is not wired up. Uncommenting this string does nothing until the
# Prisma provider is switched. Steps: DB_MIGRATION.md
# DATABASE_URL="postgresql://hn:hn@localhost:5432/hackernews?schema=public"
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"
