# Copy this file to .env before starting the app:
#   cp .env.example .env
# Then replace AUTH_SECRET with a brand-new random value of at least 32 characters.
# Either command is fine; do not reuse the printed example or any historical value:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# The old AUTH_SECRET was committed in git history (see HISTORY_CLEANUP.md and
# HISTORY_CLEANUP_V2.md). It is 31 characters and is not a placeholder. Do not
# reuse it. Startup rejects this placeholder and anything under 32 characters.
# SQLite is the database this repository runs and tests against.
DATABASE_URL="file:./dev.db"
# PostgreSQL is not the default. Uncommenting this string does nothing until the
# Prisma provider is switched and prisma/migrations-postgres/0001_init.sql is applied.
# Steps: POSTGRES_MIGRATION.md
# DATABASE_URL="postgresql://hn:hn@localhost:5432/hackernews?schema=public"
#
# Rate limits stay in process memory unless one of these is set.
# sqlite uses a file outside the Prisma database. redis is shared across instances.
# See RATE_LIMIT_REDIS.md. A Redis outage rejects the action; it does not fall back to memory.
# RATE_LIMIT_BACKEND="memory"
# RATE_LIMIT_BACKEND="sqlite"
# RATE_LIMIT_SQLITE_PATH="prisma/rate-limits.db"
# RATE_LIMIT_BACKEND="redis"
# REDIS_URL="redis://127.0.0.1:6379/0"
#
# Hot ranking stays in memory unless this is sql. See RANKING_DB.md.
# RANKING_BACKEND="memory"
# RANKING_BACKEND="sql"
AUTH_SECRET="PLACEHOLDER_REPLACE_WITH_A_NEW_SECRET"
